# SonarQube Cloud analysis settings, read by the `sonar` job in ci.yml.
#
# Re-rendered on `copier update`: put project settings in the PROJECT-SONAR
# block at the end.  A key repeated there replaces the one set above, so to
# extend a list (sonar.exclusions, sonar.coverage.exclusions) restate it in
# full with the project's entries added.

# SonarQube Cloud's defaults for a project imported from GitHub: the
# organisation is the owner's login in lower case, the key is owner_repo.
sonar.organization={{ github_org | lower }}
sonar.projectKey={{ github_org }}_{{ project_name }}

# The whole repository is analysed, so workflows, the Dockerfile and shell
# scripts are checked alongside the package; tests/ is analysed as test code.
# A file cannot be both a source and a test, hence tests/** in the exclusions.
{% if include_mcp_apps_scaffold -%}
# app.html is generated by scripts/vendor_spa.py from app.src.html (which is
# analysed) and inlines the vendored SDK, so it is not reviewed as source.
{% endif -%}
sonar.sources=.
sonar.tests=tests
sonar.exclusions=tests/**{% if include_mcp_apps_scaffold %},src/{{ python_module }}/static/app.html{% endif %}

sonar.python.version=3.11, 3.12, 3.13, 3.14

# Coverage comes from the Python 3.14 test job (`pytest --cov`, which measures
# src/{{ python_module }} only, see [tool.coverage.run]).  A Python file missing
# from that report would count as uncovered, so everything outside the package
# is excluded from coverage — it is still analysed for issues.
sonar.python.coverage.reportPaths=coverage.xml
sonar.coverage.exclusions=tests/**,scripts/**,docs/**,packaging/**,.github/**,src/{{ python_module }}/__main__.py

# PROJECT-SONAR-START — project settings; a key repeated here replaces the one above
# PROJECT-SONAR-END
